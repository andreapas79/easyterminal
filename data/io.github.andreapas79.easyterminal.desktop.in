[Desktop Entry]
Name=EasyTerminal
Comment=Use the command line
Keywords=shell;prompt;command;commandline;cmd;
TryExec=easyterminal
Exec=easyterminal
Icon=io.github.andreapas79.easyterminal
Type=Application
Categories=GNOME;GTK;System;TerminalEmulator;
StartupNotify=true
StartupWMClass=Easyterminal
X-GNOME-SingleWindow=false
Actions=new-window;preferences;

[Desktop Action new-window]
Name=New Window
Exec=easyterminal --window

[Desktop Action preferences]
Name=Preferences
Exec=easyterminal --preferences
