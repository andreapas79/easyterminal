<component
  xmlns="https://specifications.freedesktop.org/metainfo/1.0"
  xmlns:xi="http://www.w3.org/2001/XInclude"
  xmlns:its="http://www.w3.org/2005/11/its"
  type="desktop-application">
  <id>io.github.andreapas79.easyterminal.desktop</id>
  <metadata_license>GPL-3.0+ or GFDL-1.3-only</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <name>EasyTerminal</name>
  <summary>Use the command line</summary>
  <description>
    <p>EasyTerminal is a terminal emulator application for accessing a UNIX shell environment which can be used to run programs available on your system.</p>
    <p>It supports several profiles, multiple tabs and implements several keyboard shortcuts.</p>
    <p>EasyTerminal is a personal fork of GNOME Terminal 3.44 that adds renamable tabs and collapsible tab groups.</p>
  </description>
  <recommends>
    <control>console</control>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <kudos>
    <kudo>HiDpiIcon</kudo>
    <kudo>HighContrast</kudo>
    <kudo>ModernToolkit</kudo>
  </kudos>
  <url type="homepage">https://github.com/andreapas79/easyterminal</url>
  <url type="bugtracker">https://github.com/andreapas79/easyterminal/issues</url>
  <update_contact>https://github.com/andreapas79/easyterminal/issues</update_contact>
</component>
