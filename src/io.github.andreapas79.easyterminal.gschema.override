# EasyTerminal vendor defaults.
#
# Distributions customise GNOME Terminal through gschema overrides keyed on
# its schema ids (org.gnome.Terminal.*), which EasyTerminal does not share.
# This file carries the same defaults over to EasyTerminal's own schemas:
#   - Ubuntu's 10_gnome-terminal.gschema.override (package gnome-terminal)
#   - Pop!_OS's terminal profile from 50_pop-desktop.gschema.override
#     (package pop-desktop)
# Users' own settings still win over these defaults.

[io.github.andreapas79.easyterminal.Legacy.Settings]
unified-menu=false

[io.github.andreapas79.easyterminal.Legacy.Profile]
visible-name = 'Pop'
use-system-font = false
font = 'Fira Mono 12'
use-theme-colors = false
background-color = 'rgb(51,51,51)'
foreground-color = 'rgb(242,242,242)'
bold-color-same-as-fg = true
bold-color = 'rgb(115,196,143)'
cursor-colors-set = true
cursor-background-color = 'rgb(246,246,246)'
cursor-foreground-color = 'rgb(73,185,199)'
highlight-colors-set = true
highlight-background-color = 'rgb(72,185,199)'
highlight-foreground-color = 'rgb(255,255,255)'
palette = ['rgb(51,51,51)', 'rgb(204,0,0)', 'rgb(78,154,6)', 'rgb(196,160,0)', 'rgb(52,101,164)', 'rgb(117,80,123)', 'rgb(6,152,154)', 'rgb(211,215,207)', 'rgb(136,128,124)', 'rgb(241,93,34)', 'rgb(115,196,143)', 'rgb(255,206,81)', 'rgb(72,185,199)', 'rgb(173,127,168)', 'rgb(52,226,226)', 'rgb(238,238,236)']
audible-bell = false
